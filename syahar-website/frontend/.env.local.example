# Copy to .env.local and fill in. NEXT_PUBLIC_* values are safe to expose
# to the browser (the anon key is designed for it — RLS does the protecting).
# The service role key is NEVER used in the frontend; it lives only in the
# Edge Functions' secrets.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
