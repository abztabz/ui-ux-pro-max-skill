# Syahar backend env — copy to .env, fill in, NEVER commit real values.
# .env is gitignored. Real secrets live in the Supabase/Vercel vaults.

# --- Client-safe (may appear in the browser bundle) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# --- Server-only (NEVER expose to the browser) ---
# The service role key bypasses Row-Level Security. It belongs only in
# Edge Functions / server env. If it ever reaches the client, every
# family's data is exposed. Treat it like a root password.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Payment gateway (Phase 2) ---
GATEWAY_API_KEY=<razorpay-or-stripe-secret-key>
# Used to verify that a payment webhook genuinely came from the gateway.
# A webhook without a valid signature is rejected — this is what stops
# an attacker from POSTing "payment succeeded" to mark shares paid.
PAYMENT_WEBHOOK_SECRET=<gateway-webhook-signing-secret>
